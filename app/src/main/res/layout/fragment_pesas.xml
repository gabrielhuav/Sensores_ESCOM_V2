<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/ll_lives"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_heart1"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="5dp"
            android:src="@drawable/ic_heart"
            app:tint="#FF4444" />

        <ImageView
            android:id="@+id/iv_heart2"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="5dp"
            android:src="@drawable/ic_heart"
            app:tint="#FF4444" />

        <ImageView
            android:id="@+id/iv_heart3"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="5dp"
            android:src="@drawable/ic_heart"
            app:tint="#FF4444" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_weight"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="60dp"
        android:src="@drawable/ic_pesa"
        app:layout_constraintBottom_toTopOf="@id/v_track"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="#E0E0E0" />

    <View
        android:id="@+id/v_track"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginHorizontal="25dp"
        android:background="#404040"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.75" />

    <View
        android:id="@+id/v_target"
        android:layout_width="70dp"
        android:layout_height="40dp"
        android:background="#4CAF50"
        app:layout_constraintBottom_toBottomOf="@id/v_track"
        app:layout_constraintStart_toStartOf="@id/v_track"
        app:layout_constraintTop_toTopOf="@id/v_track" />

    <View
        android:id="@+id/v_indicator"
        android:layout_width="12dp"
        android:layout_height="65dp"
        android:background="#FF1744"
        app:layout_constraintBottom_toBottomOf="@id/v_track"
        app:layout_constraintStart_toStartOf="@id/v_track"
        app:layout_constraintTop_toTopOf="@id/v_track" />

    <Button
        android:id="@+id/btn_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:backgroundTint="#F44336"
        android:text="¡Presiona!"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_track" />

</androidx.constraintlayout.widget.ConstraintLayout>